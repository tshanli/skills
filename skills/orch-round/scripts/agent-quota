#!/usr/bin/env bash
# Quota of all coding agent harnesses (claude, codex, agy, ...), via cclimits.
#   agent-quota           one human-readable line (emoji, countdowns)
#   agent-quota --json    compact JSON {as_of, groups[]}: one record per quota group, windows nested (for programs)
#   agent-quota --brief   same data as --json, one plain-text line per usable group (for LLM agents):
#                         BLOCKED = a window is exhausted; TIGHT = at current pace a window runs out
#                         before it resets; AVAILABLE otherwise. Unusable harnesses go on one last line.
#   agent-quota --raw     cclimits' own raw JSON
# Other args pass through to cclimits (e.g. `agent-quota --json --claude`).
command -v cclimits >/dev/null 2>&1 || { echo "agent-quota: cclimits not installed (mise use -g npm:cclimits)" >&2; exit 127; }

mode=line; args=()
for a in "$@"; do
  case "$a" in
    --json)  mode=json ;;
    --brief) mode=brief ;;
    --raw)  mode=raw ;;
    *)      args+=("$a") ;;
  esac
done

case "$mode" in
  line) exec cclimits --oneline both --resets --cached ${args[@]+"${args[@]}"} ;;
  raw)  exec cclimits --json --cached ${args[@]+"${args[@]}"} ;;
esac

# Output: {"as_of": <UTC time ALL of this data was fetched>, "groups": [...]}
# Freshness: --json never reads cclimits' cache (it merges old per-provider entries under a fresh
#   timestamp) and calls cclimits with --no-stale-fallback, so a provider that fails right now shows
#   status "error" instead of old data. The whole fetch is cached in ~/.cache/agent-quota for
#   $AGENT_QUOTA_TTL seconds (default 60); passthrough args (e.g. --claude) bypass that cache.
# Group:  harness, group  (key = harness/group; model lists belong in the scheduler config)
#         status         ok | stale | token_expired | no_credentials | error | unparsed   (data health only)
#         available      status == ok AND every window used_pct < 100
#         blocked_until  when not available: LATEST resets_at among exhausted windows, else null
#         max_used_pct   highest used_pct over the windows (for schedulers that keep headroom)
#         windows        [{window_s, used_pct, resets_at}]
# Gemini CLI is dropped: it no longer serves AI Pro, so it would always show as unavailable.
read -r -d '' PY <<'PYEOF'
import sys, json, re, os
from datetime import datetime, timezone

CACHE = os.path.expanduser("~/.cache/agent-quota/cclimits.json")
TTL = int(os.environ.get("AGENT_QUOTA_TTL", "60"))
extra = sys.argv[1:]

def fetch():
    import subprocess
    r = subprocess.run(["cclimits", "--json", "--no-stale-fallback", *extra],
                       capture_output=True, text=True)
    try:
        return json.loads(r.stdout)
    except Exception as e:
        sys.exit(f"agent-quota: cclimits gave no JSON ({e}): {r.stderr.strip()[:200]}")

now = datetime.now(timezone.utc)
d = None
if not extra and TTL > 0:
    try:
        with open(CACHE) as f:
            c = json.load(f)
        if 0 <= now.timestamp() - c["fetched_at"] < TTL:
            d, as_of = c["data"], datetime.fromtimestamp(c["fetched_at"], timezone.utc)
    except Exception:
        pass
if d is None:
    d, as_of = fetch(), now
    if not extra and TTL > 0:
        try:
            os.makedirs(os.path.dirname(CACHE), exist_ok=True)
            tmp = f"{CACHE}.{os.getpid()}.tmp"
            with open(tmp, "w") as f:
                json.dump({"fetched_at": now.timestamp(), "data": d}, f)
            os.replace(tmp, CACHE)
        except OSError:
            pass

def iso(t): return t.astimezone(timezone.utc).replace(microsecond=0).strftime("%Y-%m-%dT%H:%M:%SZ")

SKIP = {"gemini"}
HARNESS = {"antigravity": "agy"}
WIN_S = {"five_hour": 18000, "5h": 18000, "seven_day": 604800, "7d": 604800, "weekly": 604800}

def slug(s): return re.sub(r"[^a-z0-9]+", "-", str(s).lower()).strip("-")

def pct(v):
    try: return round(float(str(v).rstrip("%")), 1)
    except (TypeError, ValueError): return None

def ts(v):
    if not v: return None
    try: t = datetime.fromisoformat(str(v).replace("Z", "+00:00"))
    except ValueError: return None
    if t.tzinfo is None: t = t.replace(tzinfo=timezone.utc)
    return iso(t)

def win(name, used, reset):
    return {"window_s": WIN_S.get(name), "used_pct": pct(used), "resets_at": ts(reset)}

def group(h, g, windows, status="ok", detail=None):
    windows = [w for w in windows if w["used_pct"] is not None]
    if status == "ok" and stale:
        status, detail = "stale", f"cclimits served {v.get('stale_age_seconds')}s-old data"
    if status == "ok" and not windows:
        status, detail = "unparsed", "no quota windows in cclimits output"
    exhausted = [w for w in windows if w["used_pct"] >= 100]
    available = status == "ok" and not exhausted
    resets = [w["resets_at"] for w in exhausted if w["resets_at"]]
    r = {"harness": h, "group": g, "status": status, "available": available,
         "blocked_until": max(resets) if (exhausted and resets) else None,   # ISO-Z strings sort as times
         "max_used_pct": max((w["used_pct"] for w in windows), default=None),
         "windows": sorted(windows, key=lambda w: w["window_s"] or 0)}
    if detail: r["detail"] = detail
    return r

groups = []
stale, v = False, {}
for key, v in d.items():
    stale = False
    if key in SKIP: continue
    h = HARNESS.get(key, key)
    if not isinstance(v, dict):
        groups.append(group(h, h, [], "unparsed")); continue
    n = len(groups)
    stale = bool(v.get("stale_fallback"))
    if key == "claude":
        ws = [win(k, w.get("used"), w.get("resets_at")) for k, w in v.items() if isinstance(w, dict) and "resets_at" in w]
        if ws: groups.append(group(h, h, ws))
    elif key == "codex":
        for b in v.get("buckets") or []:
            g = slug(b.get("limit_name") or b.get("limit_id") or h)
            groups.append(group(h, g, [win(w.get("window"), w.get("used_percent"), w.get("resets_at")) for w in b.get("windows") or []]))
    elif key == "antigravity":
        for g in v.get("quota_groups") or []:
            groups.append(group(h, slug(g.get("short_name") or g.get("name")),
                                [win(k, w.get("used_pct"), w.get("reset_time")) for k, w in (g.get("buckets") or {}).items()]))
    if len(groups) > n: continue
    if v.get("token_status") == "expired" or v.get("status") == "expired":
        groups.append(group(h, h, [], "token_expired", v.get("hint_refresh")))
    elif "error" in v:
        e = str(v["error"])
        groups.append(group(h, h, [], "no_credentials" if "credential" in e.lower() else "error", e))
    else:
        groups.append(group(h, h, [], "unparsed"))

if os.environ.get("AGENT_QUOTA_MODE") != "brief":
    print(json.dumps({"as_of": iso(as_of), "groups": groups}, separators=(",", ":")))
    sys.exit(0)

PACE_MIN_USED = 20   # below 20% used, a fast start is just a burst, not a trend

def dur(s):
    s = max(0, int(s)); d, s = divmod(s, 86400); h, s = divmod(s, 3600); m = s // 60
    return f"{d}d{h}h" if d else f"{h}h{m}m" if h else f"{m}m"

def left(at):
    return (datetime.fromisoformat(at.replace("Z", "+00:00")) - now).total_seconds()

def pace(w):
    """used share / elapsed share of the window; > 1 means it runs out before reset."""
    if not w["window_s"] or not w["resets_at"]: return None
    if w["used_pct"] < PACE_MIN_USED: return None
    elapsed = 1 - left(w["resets_at"]) / w["window_s"]
    if elapsed <= 0: return None
    return (w["used_pct"] / 100) / elapsed

WNAME = {18000: "5h", 604800: "weekly"}
head = f"quota as_of {iso(as_of)}" + (f" (now {iso(now)})" if iso(now) != iso(as_of) else "")
print(head)
unusable = []
for g in groups:
    key = f'{g["harness"]}/{g["group"]}'
    if g["status"] != "ok":
        short = g["harness"] if g["group"] == g["harness"] else key
        unusable.append(f'{short} ({g["status"]})'); continue
    parts, tight = [], False
    for w in g["windows"]:
        s = f'{WNAME.get(w["window_s"], w["window_s"])} {w["used_pct"]:g}% used'
        if w["resets_at"]: s += f', resets in {dur(left(w["resets_at"]))}'
        pc = pace(w) if w["used_pct"] < 100 else None
        if pc is not None and pc > 1:
            s += f" (pace {pc:.1f}×)"; tight = True
        parts.append(s)
    state = "BLOCKED" if not g["available"] else "TIGHT" if tight else "AVAILABLE"
    print(f"{state:<10} {key}: " + "; ".join(parts))
if unusable:
    print("unavailable: " + ", ".join(unusable))
PYEOF

AGENT_QUOTA_MODE=$mode exec python3 -I -c "$PY" ${args[@]+"${args[@]}"}
