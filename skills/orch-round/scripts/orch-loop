#!/usr/bin/env bash
# orch-loop — orch-round 的外层循环（herdr-core / hc 版）
#
# 用法：由 orch-round skill 的「启动」用 `hc run --bg --name loop -- bash <skill-base-dir>/scripts/orch-loop` 启动；
# 也可以在 Herdr 的终端里 cd 到项目根目录，手动 `bash` 运行本脚本。
# 每一轮用 `hc run --bg` 启动一个新的交互式 Claude Opus 会话（名字 orch），交给它跑
# orch-round skill；它停下后读取屏幕存档、`hc kill` + `hc rm`，上下文随之清空。
# 主控全程在 Herdr 里可见，卡在审批上时你可以直接 attach 接手。
#
# worker 由主控用 `--parent <本终端> --outlive-parent --no-notify --label orch=worker`
# 启动：它们是本循环的子终端，主控退出后继续运行，本脚本用 `hc wait --children any` 等它们。
# 两轮之间没有 LLM 在运行。
#
# 依赖：bash ≥ 4.3、jq、hc、claude、agent-quota
# 环境变量：
#   ORCH_ALLOWED_TOOLS  项目验收命令的放行规则，空格分隔，例如 'Bash(cargo test:*) Bash(npm test:*)'
#   ORCH_SETTLE_S       worker 停下后复查的间隔，默认 15 秒
#
# 退出条件：
#   .orch/STOP 存在                                     项目完成，或主控判定无法继续
#   一轮结束后既没有在跑的 worker，也没有唤醒时间         剩下的都需要用户处理

set -euo pipefail

ORCH=.orch
ROUND_PROMPT='运行 orch-round skill，跑一轮编排。'
SETTLE_S="${ORCH_SETTLE_S:-15}"
MAX_BACKOFF_S=1800

die() { echo "orch-loop: $*" >&2; exit 1; }
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$ORCH/loop.log"; }

(( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 3) )) \
  || die "需要 bash ≥ 4.3，当前是 $BASH_VERSION"
[ -n "${HC_TERMINAL_ID:-}" ] || die "不在 herdr-core 终端里（HC_TERMINAL_ID 未设置）"
for c in jq hc claude agent-quota; do command -v "$c" >/dev/null || die "找不到 $c"; done
mkdir -p "$ORCH"
# hc 不把调用者的环境变量传给新终端，所以用文件告诉主控本循环的终端地址。
echo "$HC_TERMINAL_ID" > "$ORCH/loop-terminal"

to_epoch() {  # ISO 8601 UTC，例如 2026-11-26T16:21:09Z
  date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null || date -u -d "$1" +%s
}

sleep_until() {
  local t now
  t=$(to_epoch "$1") || { log "无法解析时间 $1，等 10 分钟"; sleep 600; return; }
  now=$(date +%s)
  if (( t > now )); then log "等到 $1"; sleep $(( t - now )); fi
}

# 主控固定用 Claude Opus：Claude 组不可用时，睡到它恢复为止。
wait_for_claude() {
  local g
  g=$(agent-quota --json | jq -c '.groups[] | select(.harness == "claude" and .group == "claude")')
  [ "$(jq -r '.available' <<<"$g")" = true ] && return 0
  local until; until=$(jq -r '.blocked_until // empty' <<<"$g")
  if [ -n "$until" ]; then
    sleep_until "$until"
  else
    log "Claude 配额状态未知（$(jq -r '.status' <<<"$g")），等 10 分钟"
    sleep 600
  fi
  return 1
}

# 在跑、且没有被 park 的 worker
active_workers() {
  hc ls --label orch=worker --json \
    | jq -r '.terminals[] | select(.state == "live" and (.labels.parked // "") != "1") | .name'
}

# 是否有 worker 已经停下（idle / done / blocked / error）或已经退出
any_worker_stopped() {
  hc ls --all --label orch=worker --json | jq -e '
    any(.terminals[] | select((.labels.parked // "") != "1");
        .state == "finished" or ((.status.state // "") | IN("idle", "done", "blocked", "error")))' >/dev/null
}

# 等任一 worker 停下。停下后隔一会儿再查一次：有的 agent 回到提示符就报 idle，
# 这时后台任务可能还在跑。
wait_any_worker() {
  [ -n "$(active_workers)" ] || return 0
  local r reason
  while :; do
    r=$(hc wait --children any --timeout 600 --json 2>/dev/null || true)
    reason=$(jq -r '.reason // "error"' <<<"$r" 2>/dev/null || echo error)
    case "$reason" in
      timeout) continue ;;                 # 只是定期报到，接着等
      message) log "有人在循环终端里输入，忽略"; continue ;;
    esac
    sleep "$SETTLE_S"
    if any_worker_stopped; then log "有 worker 停下（$reason）"; return 0; fi
    log "worker 又开始工作，继续等"
  done
}

orch_state() { hc get orch --json 2>/dev/null | jq -r '.status.state // .state // "gone"'; }

run_round() {
  local allowed=("Bash(hc:*)" "Bash(git:*)" "Bash(agent-quota:*)" "Bash(jq:*)") s seen=0 i
  # shellcheck disable=SC2206
  [ -n "${ORCH_ALLOWED_TOOLS:-}" ] && allowed+=($ORCH_ALLOWED_TOOLS)

  hc kill orch >/dev/null 2>&1 || true   # 上一轮异常退出留下的
  hc rm orch >/dev/null 2>&1 || true

  hc run --bg --name orch --cwd "$PWD" --no-notify --label orch=main -- \
    claude "$ROUND_PROMPT" \
    --model opus --effort high \
    --permission-mode acceptEdits \
    --allowedTools "${allowed[@]}" >/dev/null || return 1   # 提示词放最前：--allowedTools 会吞掉后面的参数

  # 先看到它开始工作（最多等 120 秒），再等它停下。
  for i in $(seq 120); do
    [ "$(orch_state)" = working ] && { seen=1; break; }
    sleep 1
  done
  (( seen )) || log "120 秒内没看到主控开始工作，按已停下处理（i=$i）"

  local blocked_logged=0
  while :; do
    s=$(orch_state)
    case "$s" in
      idle|done) break ;;
      blocked) (( blocked_logged )) || { log "主控在等审批：在 Herdr 里 attach orch 处理"; blocked_logged=1; } ;;
      error|finished|gone) log "主控状态 $s"; break ;;
      *) blocked_logged=0 ;;
    esac
    sleep 10
  done

  hc read orch --lines 200 >>"$ORCH/rounds.log" 2>&1 || true
  hc kill orch >/dev/null 2>&1 || true
  hc rm orch >/dev/null 2>&1 || true
  [ "$s" = idle ] || [ "$s" = "done" ]
}

backoff=60
while [ ! -f "$ORCH/STOP" ]; do
  wait_any_worker

  if [ -f "$ORCH/next-wake" ]; then
    sleep_until "$(tr -d '[:space:]' < "$ORCH/next-wake")"
    rm -f "$ORCH/next-wake"
  fi

  wait_for_claude || continue

  log "开始一轮"
  if run_round; then
    backoff=60
    log "一轮结束"
  else
    log "这一轮失败，${backoff} 秒后重试（详见 $ORCH/rounds.log）"
    sleep "$backoff"
    backoff=$(( backoff * 2 > MAX_BACKOFF_S ? MAX_BACKOFF_S : backoff * 2 ))
    continue
  fi

  if [ -z "$(active_workers)" ] && [ ! -f "$ORCH/next-wake" ] && [ ! -f "$ORCH/STOP" ]; then
    log "没有在跑的 worker，也没有唤醒时间：剩下的都需要用户处理，见 $ORCH/next-round.md"
    exit 0
  fi
done

log "检测到 $ORCH/STOP，退出"
